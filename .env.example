# ============================================================
# TAXI MOTO - Variables d'environnement
# Copiez ce fichier en .env et remplissez les valeurs
# ============================================================

# ── Base de données (Supabase / PostgreSQL) ──────────────────
DATABASE_URL="postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres"
DIRECT_URL="postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres"

# ── Supabase ─────────────────────────────────────────────────
SUPABASE_URL="https://PROJECT_REF.supabase.co"
SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# ── JWT ──────────────────────────────────────────────────────
JWT_SECRET="change-me-in-production-at-least-64-chars-random"
JWT_EXPIRES_IN="7d"
JWT_REFRESH_SECRET="another-very-long-random-secret-for-refresh-tokens"
JWT_REFRESH_EXPIRES_IN="30d"

# ── Serveur ───────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
FRONTEND_URL="http://localhost:5173"

# ── OTP / SMS (Twilio - gratuit en développement) ────────────
TWILIO_ACCOUNT_SID="ACxxx"
TWILIO_AUTH_TOKEN="your-auth-token"
TWILIO_PHONE_NUMBER="+15555555555"
# Alternative gratuite: utiliser email OTP en dev
OTP_BYPASS_DEV=true  # mettre false en production

# ── Email (Resend.com - 3000 emails/mois gratuit) ─────────────
RESEND_API_KEY="re_xxx"
EMAIL_FROM="noreply@votredomaine.com"

# ── Maps (OpenStreetMap est 100% gratuit) ─────────────────────
# Optionnel: Google Maps pour meilleure qualité
GOOGLE_MAPS_API_KEY=""

# ── Push Notifications (Expo - 100% gratuit) ─────────────────
EXPO_ACCESS_TOKEN="your-expo-access-token"

# ── Stockage Fichiers (Supabase Storage - gratuit 1GB) ───────
STORAGE_BUCKET="taxi-moto-documents"

# ── Redis (Upstash - 10k req/jour gratuit) ────────────────────
REDIS_URL="redis://default:password@localhost:6379"
# En prod: REDIS_URL="rediss://default:TOKEN@HOST:PORT"

# ── Tarification ──────────────────────────────────────────────
BASE_FARE=500          # FCFA (ou votre devise)
PRICE_PER_KM=150       # par kilomètre
PRICE_PER_MINUTE=20    # par minute d'attente
MIN_FARE=1000          # tarif minimum
PLATFORM_COMMISSION=0.20  # 20% commission

# ── Admin ─────────────────────────────────────────────────────
ADMIN_EMAIL="admin@taxamoto.com"
ADMIN_PASSWORD="changeme123!"

# ── Rate Limiting ─────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000   # 15 minutes
RATE_LIMIT_MAX=100
OTP_RATE_LIMIT_MAX=5
