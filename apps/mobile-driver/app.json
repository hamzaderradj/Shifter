{
  "expo": {
    "name": "Shifter Rider",
    "slug": "shifter-rider",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0F0F1A"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.taxamoto.driver",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Shifter Rider utilise votre localisation pour gérer vos courses.",
        "NSLocationAlwaysUsageDescription": "Shifter Rider utilise votre localisation pour recevoir des courses en arrière-plan."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0F0F1A"
      },
      "package": "com.taxamoto.driver",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/logo.png",
          "color": "#2ECC71",
          "androidMode": "default",
          "androidCollapsedTitle": "Nouvelle course"
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Shifter Rider utilise votre position pour vous envoyer des courses.",
          "isIosBackgroundLocationEnabled": true
        }
      ],
      "expo-font",
      "expo-secure-store"
    ],
    "extra": {
      "apiUrl": "https://shifter-bmbf.onrender.com",
      "eas": {
        "projectId": "01a05404-ece7-4121-8e0a-7e017015efb1"
      }
    },
    "owner": "smy938",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/01a05404-ece7-4121-8e0a-7e017015efb1"
    }
  }
}
